{
	"compilerOptions": {
		"target": "ES2023",
		"lib": ["ES2023"],
		"types": ["node"],

		/* Bundler mode */
		"module": "ESNext",
		"moduleResolution": "bundler",
		"verbatimModuleSyntax": true,
		"moduleDetection": "force",
		"noEmit": true,
		"strict": true,

		/* Linting */
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"erasableSyntaxOnly": true,
		"noFallthroughCasesInSwitch": true
	},
	"include": ["vite.config.ts", "vitest.config.ts", "scripts", "tests"]
}
